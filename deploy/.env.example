# Copia in `deploy/.env` e compila. Questo file NON va in git.

# Dominio che punta all'IP della VPS. Caddy ci ottiene sopra il certificato,
# e da qui derivano SPOTIFY_REDIRECT_URI e APP_BASE_URL.
DOMAIN=stats.tuodominio.it

# --- Database -----------------------------------------------------------
# Con il Postgres incluso nello stack: host `db`, e la password deve essere la
# stessa di POSTGRES_PASSWORD qui sotto.
#   DATABASE_URL=postgresql://stats:LA_PASSWORD@db:5432/stats
#
# Con un Postgres esterno (per esempio quello gia' installato su ZimaOS, o un
# servizio gestito) metti qui la sua URL e cancella il servizio `db` dal file
# compose: il backend non ne avra' piu' bisogno.
DATABASE_URL=

POSTGRES_USER=stats
POSTGRES_DB=stats
# SOLO lettere e cifre. Questa password finisce dentro una URL: un carattere
# `/` o `@` la spezzerebbe, e `openssl rand -base64` li produce.
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 40
POSTGRES_PASSWORD=

# --- Spotify ------------------------------------------------------------
# Da https://developer.spotify.com/dashboard
# Nella dashboard registra il Redirect URI: https://<DOMAIN>/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Segreti (generali con: cd backend && npm run keys) -----------------
JWT_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=

# --- Solo per docker-compose.ghcr.yml -----------------------------------
# Immagine pubblicata dal workflow "Immagine backend" su GitHub.
# Ignorala se compili sulla VPS con il docker-compose.yml normale.
BACKEND_IMAGE=ghcr.io/gigiomiccio425/spotify-stats-tracker/backend:latest

# --- Solo per docker-compose.tunnel.yml ---------------------------------
# Token del tunnel, da Cloudflare Zero Trust > Networks > Tunnels.
# Serve quando le porte 80 e 443 sono gia' occupate (su ZimaOS le usa la
# dashboard) o la macchina non ha un IP pubblico. Con questa variante non si
# apre nessuna porta e non serve il record A.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Opzionali ----------------------------------------------------------
APP_DEEP_LINK=spotifystats://auth
# Ogni quanti minuti il poller interroga Spotify. Oltre i 20 si rischia di
# superare la finestra da 50 tracce durante gli ascolti lunghi.
POLL_INTERVAL_MINUTES=15
