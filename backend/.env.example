# --- Database -----------------------------------------------------------
# Neon: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Locale via docker-compose: postgresql://stats:stats@localhost:5432/stats
DATABASE_URL=

# --- Spotify ------------------------------------------------------------
# Da https://developer.spotify.com/dashboard -> la tua app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Deve combaciare ESATTAMENTE con il Redirect URI registrato nella dashboard.
# In locale usa http://127.0.0.1:8787/auth/spotify/callback (Spotify accetta il loopback).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback

# --- App ----------------------------------------------------------------
PORT=8787
# URL pubblico del backend, senza slash finale. In locale uguale al loopback.
APP_BASE_URL=http://127.0.0.1:8787
# Schema del deep link con cui il backend rimanda l'utente dentro l'app Android.
APP_DEEP_LINK=spotifystats://auth

# --- Segreti (generali con: npm run keys) -------------------------------
# Firma dei JWT di sessione dell'app.
JWT_SECRET=
# Chiave AES-256-GCM (32 byte in base64) per cifrare i token Spotify a riposo.
TOKEN_ENC_KEY=
# Bearer richiesto da POST /cron/poll.
CRON_SECRET=

# --- Polling ------------------------------------------------------------
# true = il poller gira dentro il processo, senza cron esterno. Da usare su un
# server sempre acceso (VPS, ZimaOS, Raspberry). Sugli host che sospendono il
# servizio dopo qualche minuto va lasciato false, perché il timer morirebbe
# insieme al processo: lì serve un cron esterno che chiami POST /cron/poll.
ENABLE_INTERNAL_CRON=false
POLL_INTERVAL_MINUTES=15
